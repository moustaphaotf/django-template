# Django
# Dev (compose local) : config.settings.docker
# Prod (image Hub)    : config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.docker
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Production (derrière Traefik / HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=https://cargo.example.com
DJANGO_USE_HTTPS=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# Gunicorn (production image default)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Image GHCR used by docker-compose.prod.yml
DOCKER_IMAGE=ghcr.io/<owner>/cargo-system:latest

# Traefik (docker-compose.prod.yml) — réseau Docker externe partagé avec Traefik
TRAEFIK_NETWORK=proxy
TRAEFIK_HOST=cargo.example.com
TRAEFIK_ROUTER=cargo-system
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# PostgreSQL
POSTGRES_DB=cargo_system
POSTGRES_USER=cargo_system
POSTGRES_PASSWORD=cargo_system
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cloudflare R2 (S3-compatible). Set USE_R2=false to use local filesystem media.
USE_R2=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
